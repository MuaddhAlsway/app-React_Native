# Deployed backend for web, Android, and iOS. Include /api.
# After changing this value, restart Expo with: npx expo start --clear
EXPO_PUBLIC_API_URL=https://ecom-native-app-server-psi.vercel.app/api

# Required for web builds; use the publishable key from Clerk.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_key
